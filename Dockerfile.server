# Build stage
FROM node:22-alpine AS builder

# Add build dependencies for native modules
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy root package files
COPY package.json package-lock.json ./

# Copy workspace package files
COPY common/package.json ./common/
COPY client/package.json ./client/
COPY server/package.json ./server/

# Install dependencies
RUN npm install

# Copy source code
COPY common ./common
COPY server ./server
# Ensure server/src/common is a real directory (handles the junction issue in Docker)
RUN rm -rf ./server/src/common
COPY common/src ./server/src/common

# Build common and then server
RUN npm run build --workspace=common
RUN npm run build --workspace=server

# Final stage
FROM node:22-alpine

# Add runtime dependencies for native modules (sharp)
RUN apk add --no-cache libc6-compat

WORKDIR /app

# Ensure uploads/logos directory exists
RUN mkdir -p uploads/logos

# Copy built assets from server/dist
# server/package.json postbuild script already prepared dist/package.json
COPY --from=builder /app/server/dist ./

# Install production dependencies
RUN npm install --production

# Expose port
EXPOSE 3001

# Start the server
CMD ["node", "index.js"]
