# MariaDB Configuration
MARIADB_ROOT_PASSWORD=root_password_change_me
MARIADB_DATABASE=comma
MARIADB_USER=comma_user
MARIADB_PASSWORD=comma_password_change_me

# Server Configuration
SERVER_PORT=3001
NODE_ENV=production
CLIENT_URL=http://localhost:4000

# Database
DB_URL=db
DB_PORT=3306
DB_NAME=comma
DB_USER=comma_user
DB_PASSWORD=comma_password_change_me

# JWT Configuration
JWT_SECRET=super_secret_key_change_me
JWT_EXPIRES_IN=7
JWT_ISSUER=comma
JWT_AUDIENCE=comma-users

# External Services
PROXY_URL=https://proxy.example.com
PROXY_API_KEY=your_proxy_api_key_here
TCMB_API_KEY=your_tcmb_api_key_here

# Security
TOTP_ENCRYPTION_KEY=your_totp_encryption_key_here

# Client Build Args
VITE_API_URL=http://localhost:3001
VITE_WEBSOCKET_URL=ws://localhost:3001/notification
VITE_ENV=production
