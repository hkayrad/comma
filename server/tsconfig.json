{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "module": "es2020",
    "moduleResolution": "node",
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules, dist"],
}